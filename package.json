{
  "name": "knowngdb",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/write-hosting-headers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev:api": "npm run build && node scripts/serve-api.mjs",
    "verify": "node scripts/verify-repository.mjs && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5"
  }
}
